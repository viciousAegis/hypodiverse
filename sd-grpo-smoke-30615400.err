++ python3 scripts/cluster/load_run_config.py configs/verl/runs/scattered_smoke.yaml
+ CONFIG_EXPORTS='if [[ -z "${DATASET_CONFIG:-}" ]]; then export DATASET_CONFIG=configs/verl/datasets/scattered_smoke.yaml; fi
if [[ -z "${PREPARE_DATASETS:-}" ]]; then export PREPARE_DATASETS=1; fi
if [[ -z "${DISCOVERY_ALGO:-}" ]]; then export DISCOVERY_ALGO=grpo; fi
if [[ -z "${MODEL_ID:-}" ]]; then export MODEL_ID=Qwen/Qwen3-1.7B; fi
if [[ -z "${DOWNLOAD_MODEL:-}" ]]; then export DOWNLOAD_MODEL=1; fi
if [[ -z "${TRAIN_FILE:-}" ]]; then export TRAIN_FILE=data/verl/scattered_causal_smoke_train.parquet; fi
if [[ -z "${VAL_FILE:-}" ]]; then export VAL_FILE=data/verl/scattered_causal_smoke_val.parquet; fi
if [[ -z "${NGPUS_PER_NODE:-}" ]]; then export NGPUS_PER_NODE=2; fi
if [[ -z "${TRAIN_BATCH_SIZE:-}" ]]; then export TRAIN_BATCH_SIZE=32; fi
if [[ -z "${PPO_MINI_BATCH_SIZE:-}" ]]; then export PPO_MINI_BATCH_SIZE=16; fi
if [[ -z "${ROLLOUT_N:-}" ]]; then export ROLLOUT_N=4; fi
