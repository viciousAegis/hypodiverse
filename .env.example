# Copy this file to `.env`. `scripts/env.sh` loads it automatically.

# Secrets
WANDB_API_KEY=your_wandb_api_key_here

# Cluster/project paths
REPO_DIR=/home/as3727/rds/hpc-work/thesis
VENV_DIR=/home/as3727/rds/hpc-work/thesis/.venv
CACHE_ROOT=/home/as3727/rds/hpc-work/thesis/.cache
DATA_ROOT=/home/as3727/rds/hpc-work/thesis/data
CHECKPOINT_ROOT=/home/as3727/rds/hpc-work/thesis/checkpoints
PYTHON_VERSION=3.11

# Model cache/download behavior for Slurm jobs
MODEL_ID=Qwen/Qwen3-4B
DOWNLOAD_MODEL=1

# veRL rollout backend
INFER_BACKEND=sglang
ROLLOUT_TP=1
ROLLOUT_GPU_MEM_UTIL=0.55

# One-time training-stack install knobs for scripts/cluster/install_verl_stack.sh
PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu121
TORCH_SPEC="torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1"
INSTALL_TORCH=1
RECREATE_VENV=0
VERL_SRC=/home/as3727/rds/hpc-work/thesis/.cache/src/verl

# If `.venv` does not exist, first Slurm run will execute `uv sync --extra verl`.
# This installs this project plus light extras; the full veRL/SGLang CUDA stack
# still needs to be installed in the venv.
BOOTSTRAP_UV_ENV=1
